---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Steven Welch — Platform Engineer, Kubernetes & AI Infrastructure"
  description="Platform and DevOps engineer operating production Kubernetes and hybrid infrastructure across AWS, Azure, GCP, and secured data-center environments."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Platform engineering · DevSecOps · AI operations</p>
      <h1>Steven Welch — Platform Engineer, Kubernetes & AI Infrastructure</h1>
      <p class="lede">
        Platform and DevOps engineer operating production Kubernetes and hybrid infrastructure across AWS, Azure, GCP, and secured data-center environments.
        My work centers on secure delivery, infrastructure automation, observability, and AI operations.
      </p>
    </div>
    <a class="profile-link" href="https://github.com/xnoto" aria-label="Steven Welch on GitHub">
      <img
        class="profile-image"
        src="https://avatars.githubusercontent.com/u/121333299?v=4"
        alt="Steven Welch"
        width="400"
        height="400"
        decoding="async"
      />
    </a>
  </section>

  <section aria-labelledby="start-here">
    <h2 id="start-here">Start here</h2>
    <div class="grid">
      <article class="card">
        <p class="status">Public work</p>
        <h3><a href="/projects/">Projects</a></h3>
        <p>Source-linked public work, reference designs, and archived experiments with clear scope.</p>
      </article>
      <article class="card">
        <p class="status">Operating principles</p>
        <h3><a href="/agentic-platform-operations/">Agentic platform operations</a></h3>
        <p>How tool-scoped automation, validation, evidence, and human approval fit together.</p>
      </article>
      <article class="card">
        <p class="status">Public infrastructure</p>
        <h3><a href="https://makeitwork.cloud">Make IT Work</a></h3>
        <p>A separate personal DevOps portal for infrastructure exploration and operational services.</p>
      </article>
    </div>
  </section>

  <section aria-labelledby="working-style">
    <h2 id="working-style">Working style</h2>
    <p>
      Platform work earns trust through clear ownership, secure delivery boundaries, validation, and evidence that a person can inspect.
    </p>
    <p>
      This site distinguishes public source, reference designs, experiments, and future direction. That distinction is part of the work.
    </p>
  </section>
</BaseLayout>
